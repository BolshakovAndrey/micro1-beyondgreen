{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["probe_id", "status", "model", "sandbox", "message"],
  "properties": {
    "probe_id": {"const": "BG-P05-LIVE-001"},
    "status": {"enum": ["passed", "abstain"]},
    "model": {"const": "gpt-5.6-sol"},
    "sandbox": {"const": "read-only"},
    "message": {"type": "string", "minLength": 1, "maxLength": 160}
  }
}
