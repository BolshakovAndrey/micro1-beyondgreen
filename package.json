{
  "name": "beyondgreen-control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "audit:licenses": "node scripts/license-audit.ts --output artifacts/phase-0.5-license-audit.json --notices THIRD_PARTY_NOTICES.md",
    "test:phase-0.5:stack": "node --test spikes/phase-0.5/stack-capabilities.test.ts",
    "test:phase-0.5:model": "node --test spikes/phase-0.5/model-probe.test.ts",
    "spike:phase-0.5:model": "node spikes/phase-0.5/run-model-probe.ts",
    "test:phase-0.5:cli-diagnostics": "node --test spikes/phase-0.5/cli-diagnostics.test.ts",
    "spike:phase-0.5:cli-diagnostics": "node spikes/phase-0.5/cli-diagnostics.ts",
    "test:phase-0.5:doctor-diagnostic": "node --test spikes/phase-0.5/doctor-diagnostic.test.ts",
    "spike:phase-0.5:doctor-diagnostic": "node spikes/phase-0.5/doctor-diagnostic.ts",
    "test:phase-0.5:network-diagnostic": "node --test spikes/phase-0.5/network-diagnostic.test.ts",
    "spike:phase-0.5:network-diagnostic": "node spikes/phase-0.5/network-diagnostic.ts",
    "test:phase-0.5:chromium": "node --test spikes/phase-0.5/chromium-runner.test.ts",
    "spike:phase-0.5:chromium": "node spikes/phase-0.5/chromium-runner.ts",
    "preflight:control": "node scripts/preflight-check.ts --phase control-plane --denylist \"$MICRO1_PRIVATE_DENYLIST\"",
    "preflight:implementation": "node scripts/preflight-check.ts --phase implementation --denylist \"$MICRO1_PRIVATE_DENYLIST\""
  },
  "dependencies": {
    "@preact/signals-react": "3.12.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3"
  }
}
