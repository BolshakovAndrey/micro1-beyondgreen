{
  "name": "beyondgreen-control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "test": "node scripts/task.ts test:all",
    "compile": "tsc -p tsconfig.json --noEmit",
    "task": "node scripts/task.ts",
    "preflight:control": "node scripts/preflight-check.ts --phase control-plane --denylist \"$MICRO1_PRIVATE_DENYLIST\"",
    "preflight:implementation": "node scripts/preflight-check.ts --phase implementation --denylist \"$MICRO1_PRIVATE_DENYLIST\""
  },
  "dependencies": {
    "@preact/signals-react": "3.12.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3"
  }
}
